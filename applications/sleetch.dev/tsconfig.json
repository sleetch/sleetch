{
	"mdx": {
		"checkMdx": true
	},
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2022"
		],
		"moduleResolution": "bundler",
		"paths": {
			"@/*": [
				"./src/*"
			]
		},
		"baseUrl": ".",
		"rootDirs": [
			".",
			"./.react-router/types"
		],
		"allowJs": true
	},
	"include": [
		"src/**/*",
		"**/.server/**/*",
		"**/.client/**/*",
		".react-router/types/**/*"
	]
}

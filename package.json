{
  "name": "ladoc",
  "private": true,
  "scripts": {
    "build": "bunx bun-workspaces run build 'path:packages/*' --dep-order --output-style=prefixed ",
    "dev": "bunx bun-workspaces run dev",
    "changeset": "changeset",
    "ci:version": "changeset version && bun update",
    "ci:publish": "bun run build && bun scripts/publish.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-workspaces": "^1.12.0",
    "publint": "^0.3.22",
    "tsdown": "^0.22.14",
    "@changesets/cli": "^2.31.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "./packages/*",
    "./examples/*"
  ]
}

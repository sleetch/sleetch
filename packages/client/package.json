{
  "name": "@ladoc/client",
  "version": "1.0.4",
  "type": "module",
  "files": [
    "dist",
    "src/styles"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@ladoc/core": "workspace:*",
    "@ladoc/styles": "workspace:*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./markdown.css": {
      "default": "./src/styles/markdown.css"
    },
    "./manifest.js": "./.ladoc/manifest.js",
    "./trees/*.js": "./.ladoc/trees/*.js",
    "./markdown-modules/*.js": "./.ladoc/markdown-modules/*.js"
  }
}

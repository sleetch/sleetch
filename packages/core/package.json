{
  "name": "@ladoc/core",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./compiler": {
      "import": "./dist/compiler/index.js",
      "require": "./dist/compiler/index.cjs"
    },
    "./configuration": {
      "import": "./dist/configuration/index.js",
      "require": "./dist/configuration/index.cjs"
    },
    "./markdown": {
      "import": "./dist/markdown/index.js",
      "require": "./dist/markdown/index.cjs"
    },
    "./shared": {
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@mdit/plugin-katex": "^1.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "@shikijs/transformers": "^4.3.1",
    "@shikijs/twoslash": "^4.3.1",
    "beautiful-mermaid": "^1.1.3",
    "hast": "^1.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-string": "^3.0.1",
    "markdown-it-async": "^2.2.0",
    "marked": "^18.0.5",
    "marked-katex-extension": "^5.1.10",
    "mdast-util-to-string": "^4.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts"
}
